# 1.Develop a python program to read 2 numbers from the keyboard & perform
# the basic arithmetic operations based on the choice (1-Add, 2-Subtract, 3-Multiply, 4-Divide)

print("Select operations\n")
print("1. Addition\n")
print("2. Subtraction\n")
print("3. Multiplication\n")
print("4. Division\n")

operation = int(input("Enter the choice of operation 1/2/3/4: "))
n1 = float(input("Enter the first number: "))
n2 = float(input("Enter the second number: "))

if operation == 1:
    print("Addition of", n1, "and", n2, "is:", n1 + n2)

elif operation == 2:
    print("Subtraction of", n1, "and", n2, "is:", n1 - n2)

elif operation == 3:
    print("Multiplication of", n1, "and", n2, "is:", n1 * n2)

elif operation == 4:
    print("Division of", n1, "and", n2, "is:", n1 / n2)

else:
    print("Invalid choice")